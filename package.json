{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && next dev",
    "postdev": "npm run services:stop",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:wait:database": "node infra/scripts/wait-for-postgres",
    "migrations:create": "node-pg-migrate create -m infra/migrations",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "migrations:up:dry": "node-pg-migrate -m infra/migrations --envPath .env.development --dry-run up",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "test": "npm run services:up && concurrently --names next,jest  --hide next -k -s command-jest 'next dev' 'jest --runInBand' --verbose",
    "posttest": "npm run services:stop",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "",
  "license": "MIT",
  "description": "",
  "dependencies": {
    "async-retry": "1.3.3",
    "bcryptjs": "3.0.3",
    "cookie": "^1.0.2",
    "next": "16.4.3",
    "next-connect": "^1.0.0",
    "node-pg-migrate": "7.6.1",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swr": "2.5.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@faker-js/faker": "9.7.0",
    "@next/eslint-plugin-next": "^16.4.3",
    "commitizen": "4.3.2",
    "concurrently": "10.0.6",
    "cz-conventional-changelog": "3.3.0",
    "dotenv": "18.0.9",
    "dotenv-expand": "1000.0.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.17.0",
    "husky": "9.1.7",
    "jest": "29.6.2",
    "prettier": "3.9.10",
    "set-cookie-parser": "2.7.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": "24"
  }
}
